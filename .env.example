# Google Cloud runtime backends
MEMORY_BACKEND=firestore
PERSISTENCE_BACKEND=firestore
AUTH_BACKEND=identity-platform
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_PROFILE_COLLECTION=synchron-profile-memory-v1
FIRESTORE_CONVERSATION_COLLECTION=synchron-conversation-memory-v1
FIRESTORE_CONFIRMATION_COLLECTION=synchron-confirmations-v1
FIRESTORE_AUDIT_COLLECTION=synchron-action-audit-v1
FIRESTORE_TESTER_ACCESS_COLLECTION=synchron-tester-access-v1
FIRESTORE_WORKSPACE_COLLECTION=synchron-workspaces-v1
FIRESTORE_TASK_COLLECTION=synchron-tasks-v1
FIRESTORE_GITHUB_SESSION_COLLECTION=synchron-github-sessions-v1
FIRESTORE_GOOGLE_SESSION_COLLECTION=synchron-google-sessions-v1
FIRESTORE_MCP_GRANT_COLLECTION=synchron-mcp-oauth-grants-v1
FIRESTORE_MCP_REPLAY_COLLECTION=synchron-mcp-oauth-replay-v1
FIRESTORE_REQUEST_TIMEOUT_MS=10000
STORAGE_HEALTH_TIMEOUT_MS=5000
BACKUP_HEALTH_TIMEOUT_MS=15000

# Identity Platform
IDENTITY_PLATFORM_PROJECT_ID=
IDENTITY_PLATFORM_API_KEY=
IDENTITY_PLATFORM_TIMEOUT_MS=10000
IDENTITY_PLATFORM_REQUIRE_EMAIL_VERIFICATION=true
USER_SESSION_ENCRYPTION_KEY=
SYNCHRON_PRIMARY_USER_ID=
SYNCHRON_TEST_INVITE_CODE=your-private-test-invite-code

# Required stable owner identifier and MCP protection
MEMORY_OWNER_ID=your-stable-memory-owner-id
MCP_ACCESS_TOKEN=your-long-random-mcp-access-token
MCP_OAUTH_SECRET=
MCP_RESOURCE_URL=https://cloudaicore.com/mcp
MCP_OPENAI_TUNNEL_RESOURCE_URL=

# OpenAI configuration (chat, planning, search, images and file analysis)
OPENAI_API_KEY=your-openai-api-key
AI_CORE_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_PLANNER_MODEL=gpt-5.6-luna
WEB_SEARCH_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_DOCUMENT_MODEL=gpt-4o-mini
OPENAI_RESPONSES_URL=
OPENAI_API_URL=
OPENAI_TIMEOUT_MS=30000
OPENAI_PLANNER_TIMEOUT_MS=30000
CODEX_AGENT_ENABLED=true
OPENAI_CODEX_MODEL=gpt-5.6-terra
CODEX_AGENT_TIMEOUT_MS=180000

# Optional conversational providers (selected explicitly through AI_CORE_PROVIDER)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=30000
GROK_API_KEY=
GROK_MODEL=grok-4.5
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_TIMEOUT_MS=30000

# GitHub OAuth App and Google OAuth integrations
COPILOT_AUTOMATION_ENABLED=false
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
GITHUB_REDIRECT_URI=
GITHUB_SESSION_ENCRYPTION_KEY=
GITHUB_REPOSITORY=radostinvgeorgiev-commits/sunchron-backend
SYNCHRON_OWNER_GITHUB_LOGIN=radostinvgeorgiev-commits
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://cloudaicore.com/api/google/callback
GOOGLE_SESSION_ENCRYPTION_KEY=your-long-random-session-encryption-key
GOOGLE_CONNECT_URL=

# Server configuration
PORT=8080
NODE_ENV=development
OAUTH_RATE_LIMIT=60
PRIVATE_API_RATE_LIMIT=300
PAID_AI_RATE_LIMIT=60
CHATGPT_WORK_URL=https://chatgpt.com/
APP_COMMIT_SHA=

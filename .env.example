# Persistence backend. DigitalOcean keeps the default OpenSearch path until the
# Google Cloud staging acceptance is green. Cloud Run uses firestore explicitly.
MEMORY_BACKEND=opensearch
PERSISTENCE_BACKEND=opensearch

# Firestore Configuration (required when either backend is firestore)
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_PROFILE_COLLECTION=synchron-profile-memory-v1
FIRESTORE_CONVERSATION_COLLECTION=synchron-conversation-memory-v1
FIRESTORE_CONFIRMATION_COLLECTION=synchron-confirmations-v1
FIRESTORE_AUDIT_COLLECTION=synchron-action-audit-v1
FIRESTORE_TESTER_ACCESS_COLLECTION=synchron-tester-access-v1
FIRESTORE_REQUEST_TIMEOUT_MS=10000

# Legacy OpenSearch Configuration
OPENSEARCH_USERNAME=your-username
OPENSEARCH_PASSWORD=your-password
OPENSEARCH_HOST=your-host
OPENSEARCH_PORT=your-port
# Optional exact DigitalOcean cluster binding for backup checks.
OPENSEARCH_DATABASE_ID=
# TLS certificate verification is enabled by default and always enforced in production.
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=true
# Optional index for server-approved tester accounts. The default is safe.
TESTER_ACCESS_INDEX=synchron-tester-access-v1

# Required stable owner identifier used to isolate the primary user's memory.
MEMORY_OWNER_ID=your-stable-memory-owner-id
# Required bearer token for the protected MCP bridge. Use a long random secret.
# It remains the OAuth fallback only while MCP_OAUTH_SECRET is absent.
MCP_ACCESS_TOKEN=your-long-random-mcp-access-token
# Optional dedicated OAuth key (minimum 32 characters). Leave empty until the
# controlled migration; never reuse the static bearer value.
MCP_OAUTH_SECRET=
# Optional canonical HTTPS MCP resource. Production defaults to this URL.
MCP_RESOURCE_URL=https://synchron.foundation/mcp
# Optional exact resource URL generated for the approved OpenAI Secure MCP Tunnel.
MCP_OPENAI_TUNNEL_RESOURCE_URL=
# Optional OpenSearch index for one-time OAuth grant consumption.
MCP_OAUTH_REPLAY_INDEX=synchron-mcp-oauth-replay-v1

# Auth backend. Google Cloud staging uses identity-platform; DigitalOcean keeps
# supabase until the controlled user migration and cutover are accepted.
AUTH_BACKEND=supabase
IDENTITY_PLATFORM_PROJECT_ID=
IDENTITY_PLATFORM_API_KEY=
IDENTITY_PLATFORM_TIMEOUT_MS=10000
IDENTITY_PLATFORM_REQUIRE_EMAIL_VERIFICATION=true
USER_SESSION_ENCRYPTION_KEY=
SYNCHRON_PRIMARY_USER_ID=

# Legacy Supabase Auth compatibility during the migration window.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Required dedicated key. Supabase sessions never reuse another integration's
# encryption key.
SUPABASE_SESSION_ENCRYPTION_KEY=your-long-random-session-encryption-key
# Optional operational tester-auth secret. Normal user registration is enabled
# by complete Supabase auth configuration, including the dedicated session key,
# and never asks the user for this value.
SYNCHRON_TEST_INVITE_CODE=your-private-test-invite-code
# Legacy owner mapping used only while AUTH_BACKEND=supabase.
SYNCHRON_PRIMARY_SUPABASE_USER_ID=

# OpenAI Configuration (Required for chat, Codex, web search, images and file analysis)
OPENAI_API_KEY=your-openai-api-key
AI_CORE_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_PLANNER_MODEL=gpt-5.6-luna
WEB_SEARCH_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_DOCUMENT_MODEL=gpt-4o-mini
# Optional Responses API endpoint used by chat, planning and Codex analysis.
OPENAI_RESPONSES_URL=
# Legacy endpoint override used only by the old image-analysis flow.
OPENAI_API_URL=
OPENAI_TIMEOUT_MS=30000
OPENAI_PLANNER_TIMEOUT_MS=30000
# Optional Codex specialist. It reuses OPENAI_API_KEY and is enabled unless
# explicitly set to false. The first release is read-only and network-disabled.
CODEX_AGENT_ENABLED=true
OPENAI_CODEX_MODEL=gpt-5.6-terra
CODEX_AGENT_TIMEOUT_MS=180000

# Optional conversational providers. Select one explicitly with
# AI_CORE_PROVIDER=gemini or AI_CORE_PROVIDER=grok; OpenAI remains the default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=30000
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_TIMEOUT_MS=30000

# GitHub OAuth App. Copilot automation stays off unless explicitly enabled.
COPILOT_AUTOMATION_ENABLED=false
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
# Optional overrides. Production defaults to synchron.foundation and derives
# the session encryption key from the GitHub client secret when omitted.
GITHUB_REDIRECT_URI=
GITHUB_SESSION_ENCRYPTION_KEY=
GITHUB_REPOSITORY=radostinvgeorgiev-commits/sunchron-backend
# Optional explicit override. Otherwise the owner is derived from GITHUB_REPOSITORY.
SYNCHRON_OWNER_GITHUB_LOGIN=radostinvgeorgiev-commits
GITHUB_SESSION_INDEX=synchron-github-sessions-v1
GITHUB_API_URL=https://api.github.com
# Legacy fallback only. Current production write tasks use the owner OAuth session.
GITHUB_TOKEN=

# Google OAuth (Required for Drive, Gmail and the connected Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://synchron.foundation/api/google/callback
GOOGLE_SESSION_ENCRYPTION_KEY=your-long-random-session-encryption-key
GOOGLE_SESSION_INDEX=synchron-google-sessions-v1
GOOGLE_CONNECT_URL=

# Optional: protected infrastructure diagnostics
DIGITALOCEAN_API_TOKEN=
# Legacy alias accepted by the runtime; prefer DIGITALOCEAN_API_TOKEN.
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_APP_ID=
DIGITALOCEAN_API_URL=https://api.digitalocean.com/v2
DIGITALOCEAN_REQUEST_TIMEOUT_MS=15000
DIGITALOCEAN_DASHBOARD_URL=https://cloud.digitalocean.com/
CLOUDFLARE_API_TOKEN=
# Optional. Defaults to the production domain.
CLOUDFLARE_ZONE_NAME=synchron.foundation
# Optional direct override; normally the zone is discovered by name.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_REQUEST_TIMEOUT_MS=10000
CLOUDFLARE_DASHBOARD_URL=https://dash.cloudflare.com/

# Optional: Server Configuration
PORT=8080
NODE_ENV=development
# Requests per 15 minutes. Defaults: OAuth 60, private API 300, paid AI 60.
OAUTH_RATE_LIMIT=60
PRIVATE_API_RATE_LIMIT=300
PAID_AI_RATE_LIMIT=60
CHATGPT_WORK_URL=https://chatgpt.com/
# APP_COMMIT_SHA is supplied automatically by the deployment platform.
APP_COMMIT_SHA=

# Optional storage/index overrides. Defaults are safe when omitted.
MEMORY_INDEX=synchron-profile-memory-v1
CONVERSATION_INDEX=synchron-conversation-memory-v1
AUDIT_INDEX=synchron-action-audit
CONFIRMATION_INDEX=synchron-confirmations-v1
SUPABASE_TIMEOUT_MS=5000
STORAGE_HEALTH_TIMEOUT_MS=5000
BACKUP_HEALTH_TIMEOUT_MS=15000
OPENSEARCH_BACKUP_MAX_AGE_HOURS=48
OPENSEARCH_REQUEST_TIMEOUT_MS=10000

# OpenSearch Configuration (Required for memory/data features)
OPENSEARCH_USERNAME=your-username
OPENSEARCH_PASSWORD=your-password
OPENSEARCH_HOST=your-host
OPENSEARCH_PORT=your-port
# TLS certificate verification is enabled by default and always enforced in production.
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=true
# Optional index for server-approved tester accounts. The default is safe.
TESTER_ACCESS_INDEX=synchron-tester-access-v1

# Required stable owner identifier used to isolate the primary user's memory.
MEMORY_OWNER_ID=your-stable-memory-owner-id
# Required bearer token for the protected MCP bridge. Use a long random secret.
# The same secret derives a separate OAuth signing key; its raw value is never
# used as an OAuth access token.
MCP_ACCESS_TOKEN=your-long-random-mcp-access-token
# Optional canonical HTTPS MCP resource. Production defaults to this URL.
MCP_RESOURCE_URL=https://synchron.foundation/mcp

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Required dedicated key. Supabase sessions never reuse another integration's
# encryption key.
SUPABASE_SESSION_ENCRYPTION_KEY=your-long-random-session-encryption-key
# Optional. At least 8 characters. Registration stays closed when omitted.
SYNCHRON_TEST_INVITE_CODE=your-private-test-invite-code
# Optional. Maps one Supabase user to the existing primary-user memory.
SYNCHRON_PRIMARY_SUPABASE_USER_ID=

# OpenAI Configuration (Required for chat, web search, images and file analysis)
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_PLANNER_MODEL=gpt-5.6-luna
WEB_SEARCH_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_DOCUMENT_MODEL=gpt-4o-mini

# GitHub OAuth App (Required for confirmed Copilot coding tasks)
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
# Optional overrides. Production defaults to synchron.foundation and derives
# the session encryption key from the GitHub client secret when omitted.
GITHUB_REDIRECT_URI=
GITHUB_SESSION_ENCRYPTION_KEY=
GITHUB_REPOSITORY=radostinvgeorgiev-commits/sunchron-backend
# Optional explicit override. Otherwise the owner is derived from GITHUB_REPOSITORY.
SYNCHRON_OWNER_GITHUB_LOGIN=radostinvgeorgiev-commits

# Google OAuth (Required for Drive, Gmail and the connected Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://synchron.foundation/api/google/callback
GOOGLE_SESSION_ENCRYPTION_KEY=your-long-random-session-encryption-key

# Optional: protected infrastructure diagnostics
DIGITALOCEAN_API_TOKEN=
# Legacy alias accepted by the runtime; prefer DIGITALOCEAN_API_TOKEN.
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_APP_ID=
DIGITALOCEAN_API_URL=https://api.digitalocean.com/v2
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4

# Optional: Logic Core Service
LOGIC_CORE_URL=http://127.0.0.1:8000

# Optional: Server Configuration
PORT=8080
NODE_ENV=development
# Requests per 15 minutes. Defaults: OAuth 60, private API 300, paid AI 60.
OAUTH_RATE_LIMIT=60
PRIVATE_API_RATE_LIMIT=300
PAID_AI_RATE_LIMIT=60

# Шаблонът е непълен нарочно. Замени всички означени placeholder стойности,
# прегледай migration gates и не го прилагай без изрично одобрение.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: "__CLOUD_RUN_SERVICE_NAME__"
  annotations:
    run.googleapis.com/ingress: all
  labels:
    app: synchron-backend
    synchron-runtime-stage: production
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "2"
        run.googleapis.com/execution-environment: gen2
        run.googleapis.com/cpu-throttling: "true"
        run.googleapis.com/secrets: "openai-api-key:projects/__GCP_PROJECT_NUMBER__/secrets/__OPENAI_API_KEY_SECRET__,gemini-api-key:projects/__GCP_PROJECT_NUMBER__/secrets/__GEMINI_API_KEY_SECRET__,grok-api-key:projects/__GCP_PROJECT_NUMBER__/secrets/__GROK_API_KEY_SECRET__,identity-platform-api-key:projects/__GCP_PROJECT_NUMBER__/secrets/__IDENTITY_PLATFORM_API_KEY_SECRET__,user-session-key:projects/__GCP_PROJECT_NUMBER__/secrets/__USER_SESSION_ENCRYPTION_KEY_SECRET__,github-session-key:projects/__GCP_PROJECT_NUMBER__/secrets/__GITHUB_SESSION_ENCRYPTION_KEY_SECRET__,google-session-key:projects/__GCP_PROJECT_NUMBER__/secrets/__GOOGLE_SESSION_ENCRYPTION_KEY_SECRET__,tester-invite-code:projects/__GCP_PROJECT_NUMBER__/secrets/__SYNCHRON_TEST_INVITE_CODE_SECRET__,mcp-access-token:projects/__GCP_PROJECT_NUMBER__/secrets/__MCP_ACCESS_TOKEN_SECRET__,mcp-oauth-secret:projects/__GCP_PROJECT_NUMBER__/secrets/__MCP_OAUTH_SECRET_NAME__"
      labels:
        app: synchron-backend
    spec:
      serviceAccountName: "__CLOUD_RUN_RUNTIME_SERVICE_ACCOUNT__"
      containerConcurrency: 20
      timeoutSeconds: 300
      containers:
        - name: web
          image: "__ARTIFACT_REGISTRY_IMAGE_URI__"
          ports:
            - name: http1
              containerPort: 8080
          env:
            - name: NODE_ENV
              value: production
            - name: APP_COMMIT_SHA
              value: "__COMMIT_SHA__"
            - name: AI_CORE_PROVIDER
              value: openai
            - name: OPENAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: openai-api-key
                  key: "__OPENAI_API_KEY_VERSION__"
            - name: OPENAI_CODEX_MODEL
              value: gpt-5.6-terra
            - name: GEMINI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: gemini-api-key
                  key: "__GEMINI_API_KEY_VERSION__"
            - name: GEMINI_MODEL
              value: gemini-2.5-flash
            - name: GROK_API_KEY
              valueFrom:
                secretKeyRef:
                  name: grok-api-key
                  key: "__GROK_API_KEY_VERSION__"
            - name: GROK_MODEL
              value: grok-4.5
            - name: GROK_API_URL
              value: https://api.x.ai/v1/chat/completions
            - name: GROK_TIMEOUT_MS
              value: "30000"
            - name: MEMORY_BACKEND
              value: firestore
            - name: PERSISTENCE_BACKEND
              value: firestore
            - name: MEMORY_OWNER_ID
              value: "__MEMORY_OWNER_ID__"
            - name: GOOGLE_CLOUD_PROJECT
              value: "__GCP_PROJECT_ID__"
            - name: FIRESTORE_DATABASE_ID
              value: "(default)"
            - name: FIRESTORE_PROFILE_COLLECTION
              value: synchron-profile-memory-v1
            - name: FIRESTORE_CONVERSATION_COLLECTION
              value: synchron-conversation-memory-v1
            - name: FIRESTORE_CONFIRMATION_COLLECTION
              value: synchron-confirmations-v1
            - name: FIRESTORE_AUDIT_COLLECTION
              value: synchron-action-audit-v1
            - name: FIRESTORE_TESTER_ACCESS_COLLECTION
              value: synchron-tester-access-v1
            - name: FIRESTORE_WORKSPACE_COLLECTION
              value: synchron-workspaces-v1
            - name: FIRESTORE_TASK_COLLECTION
              value: synchron-tasks-v1
            - name: FIRESTORE_GITHUB_SESSION_COLLECTION
              value: synchron-github-sessions-v1
            - name: FIRESTORE_GOOGLE_SESSION_COLLECTION
              value: synchron-google-sessions-v1
            - name: FIRESTORE_MCP_GRANT_COLLECTION
              value: synchron-mcp-oauth-grants-v1
            - name: FIRESTORE_MCP_REPLAY_COLLECTION
              value: synchron-mcp-oauth-replay-v1
            - name: AUTH_BACKEND
              value: identity-platform
            - name: IDENTITY_PLATFORM_PROJECT_ID
              value: "__GCP_PROJECT_ID__"
            - name: IDENTITY_PLATFORM_REQUIRE_EMAIL_VERIFICATION
              value: "true"
            - name: TESTER_REGISTRATION_ENABLED
              value: "true"
            - name: IDENTITY_PLATFORM_API_KEY
              valueFrom:
                secretKeyRef:
                  name: identity-platform-api-key
                  key: "__IDENTITY_PLATFORM_API_KEY_VERSION__"
            - name: USER_SESSION_ENCRYPTION_KEY
              valueFrom:
                secretKeyRef:
                  name: user-session-key
                  key: "__USER_SESSION_ENCRYPTION_KEY_VERSION__"
            - name: GITHUB_SESSION_ENCRYPTION_KEY
              valueFrom:
                secretKeyRef:
                  name: github-session-key
                  key: "__GITHUB_SESSION_ENCRYPTION_KEY_VERSION__"
            - name: GITHUB_REPOSITORY
              value: radostinvgeorgiev-commits/sunchron-backend
            - name: SYNCHRON_OWNER_GITHUB_LOGIN
              value: radostinvgeorgiev-commits
            - name: GOOGLE_SESSION_ENCRYPTION_KEY
              valueFrom:
                secretKeyRef:
                  name: google-session-key
                  key: "__GOOGLE_SESSION_ENCRYPTION_KEY_VERSION__"
            - name: SYNCHRON_TEST_INVITE_CODE
              valueFrom:
                secretKeyRef:
                  name: tester-invite-code
                  key: "__SYNCHRON_TEST_INVITE_CODE_VERSION__"
            - name: MCP_RESOURCE_URL
              value: "__MCP_RESOURCE_URL__"
            - name: MCP_ISSUER_URL
              value: "__MCP_ISSUER_URL__"
            - name: MCP_ACCESS_TOKEN
              valueFrom:
                secretKeyRef:
                  name: mcp-access-token
                  key: "__MCP_ACCESS_TOKEN_VERSION__"
            - name: MCP_OAUTH_SECRET
              valueFrom:
                secretKeyRef:
                  name: mcp-oauth-secret
                  key: "__MCP_OAUTH_SECRET_VERSION__"
          resources:
            limits:
              cpu: "1"
              memory: 512Mi
          startupProbe:
            httpGet:
              path: /health
              port: 8080
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            periodSeconds: 30
            timeoutSeconds: 3
            failureThreshold: 3

# Шаблонът е непълен нарочно. Замени всички __PLACEHOLDER__ стойности,
# прегледай migration gates и не го прилагай без изрично одобрение.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: "__CLOUD_RUN_SERVICE_NAME__"
  labels:
    app.kubernetes.io/name: synchron-backend
    synchron.foundation/migration-stage: foundation-only
spec:
  template:
    metadata:
      labels:
        app.kubernetes.io/name: synchron-backend
    spec:
      serviceAccountName: "__CLOUD_RUN_RUNTIME_SERVICE_ACCOUNT__"
      containerConcurrency: 20
      timeoutSeconds: 300
      containers:
        - name: web
          image: "__ARTIFACT_REGISTRY_IMAGE_URI__"
          ports:
            - name: http1
              containerPort: 8080
          env:
            - name: NODE_ENV
              value: production
            - name: PORT
              value: "8080"
            - name: APP_COMMIT_SHA
              value: "__COMMIT_SHA__"
            - name: MEMORY_BACKEND
              value: firestore
            - name: PERSISTENCE_BACKEND
              value: firestore
            - name: GOOGLE_CLOUD_PROJECT
              value: "__GCP_PROJECT_ID__"
            - name: FIRESTORE_DATABASE_ID
              value: "(default)"
            - name: FIRESTORE_WORKSPACE_COLLECTION
              value: synchron-workspaces-v1
            - name: FIRESTORE_TASK_COLLECTION
              value: synchron-tasks-v1
            - name: FIRESTORE_GITHUB_SESSION_COLLECTION
              value: synchron-github-sessions-v1
            - name: FIRESTORE_GOOGLE_SESSION_COLLECTION
              value: synchron-google-sessions-v1
            - name: FIRESTORE_MCP_GRANT_COLLECTION
              value: synchron-mcp-oauth-grants-v1
            - name: FIRESTORE_MCP_REPLAY_COLLECTION
              value: synchron-mcp-oauth-replay-v1
            - name: AUTH_BACKEND
              value: identity-platform
            - name: IDENTITY_PLATFORM_PROJECT_ID
              value: "__GCP_PROJECT_ID__"
            - name: IDENTITY_PLATFORM_REQUIRE_EMAIL_VERIFICATION
              value: "true"
            - name: IDENTITY_PLATFORM_API_KEY
              valueFrom:
                secretKeyRef:
                  name: "__IDENTITY_PLATFORM_API_KEY_SECRET__"
                  key: "__IDENTITY_PLATFORM_API_KEY_VERSION__"
            - name: USER_SESSION_ENCRYPTION_KEY
              valueFrom:
                secretKeyRef:
                  name: "__USER_SESSION_ENCRYPTION_KEY_SECRET__"
                  key: "__USER_SESSION_ENCRYPTION_KEY_VERSION__"
          startupProbe:
            httpGet:
              path: /health
              port: 8080
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            periodSeconds: 30
            timeoutSeconds: 3
            failureThreshold: 3
